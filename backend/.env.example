# Required: copy this file to backend/.env and fill the two Supabase values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local test JWT configuration. Replace JWT_SECRET outside local test use.
JWT_SECRET=local-test-only-change-before-deployment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

AUTH_SVC_URL=http://localhost:8001
USER_SVC_URL=http://localhost:8002
STUDENTFEE_SVC_URL=http://localhost:8003
PAYMENT_SVC_URL=http://localhost:8004

# Compatibility variable read specifically by backend/auth/service.py.
USER_SERVICE_URL=http://localhost:8002/user

# Leave SMTP_USER/SMTP_PASS empty to print synthetic OTP email in dev mode.
MAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

